; Engine configuration file.
; UNDERLIGHT - Cobalt Bay
; Godot 4.3

config_version=5

[application]

config/name="Underlight: Cobalt Bay"
config/description="A first-person, mobile-first open-world business empire sim set in the port city of Cobalt Bay."
config/version="0.4.0"
run/main_scene="res://scenes/ui/boot.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043, 0.055, 0.086, 1)

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameConfig="*res://src/autoload/game_config.gd"
GameData="*res://src/autoload/game_data.gd"
SettingsService="*res://src/autoload/settings_service.gd"
PlayerInput="*res://src/autoload/player_input.gd"
GameState="*res://src/autoload/game_state.gd"
EconomyService="*res://src/autoload/economy_service.gd"
MissionService="*res://src/autoload/mission_service.gd"
EnforcementService="*res://src/autoload/enforcement_service.gd"
AudioDirector="*res://src/autoload/audio_director.gd"
SaveService="*res://src/autoload/save_service.gd"
SceneRouter="*res://src/autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

